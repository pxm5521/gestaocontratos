rules_version = '2';

// Mesma lógica das regras do Firestore: qualquer usuário autenticado
// pode ler/gravar os arquivos (modelos de BM e planilhas de custo).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
